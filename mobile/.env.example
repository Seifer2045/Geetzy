# Copy to .env
# true = use built-in sample data (no backend needed)
EXPO_PUBLIC_USE_MOCK=true
# Your FastAPI URL when USE_MOCK=false (use your PC's LAN IP for a phone on USB/Wi-Fi)
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000

# --- Google sign-in with Supabase (leave empty = any tap signs you in, works in Expo Go) ---
# Supabase dashboard -> Project Settings -> API: Project URL + "anon"/"publishable" key (public, safe in the app)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Google Cloud -> Credentials -> the WEB application OAuth client ID (not the Android one)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
