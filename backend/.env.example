# Copy to .env (local) and add the same names in Vercel → Settings → Environment Variables.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
GEMINI_API_KEY=
JSON2VIDEO_API_KEY=
INTERNAL_SECRET=<random, also stored in Supabase Vault as internal_secret>
WEBHOOK_SECRET=<random>
PUBLIC_BASE_URL=https://<your-backend>.vercel.app
ALLOW_FAKE_PAYMENTS=true
# Song maker: loudly (temporary, instrumental only) or lyria (Google, sung)
SONG_PROVIDER=loudly
LOUDLY_API_KEY=
# Optional overrides
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# LYRIA_MODEL=lyria-3-clip-preview
