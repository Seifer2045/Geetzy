# Copy to .env (local) and add the same names in Vercel → Settings → Environment Variables.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
JSON2VIDEO_API_KEY=
INTERNAL_SECRET=<random, also stored in Supabase Vault as internal_secret>
WEBHOOK_SECRET=<random>
PUBLIC_BASE_URL=https://<your-backend>.vercel.app
ALLOW_FAKE_PAYMENTS=true
# AI songs (ElevenLabs Music). Empty = AI songs fail; own/fixed songs still work.
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=music_v1
# xAI Grok writes the video-design JSON in the admin (once per template, never per gift).
XAI_API_KEY=
# XAI_MODEL=grok-4
# XAI_CALLS_PER_DAY=40
